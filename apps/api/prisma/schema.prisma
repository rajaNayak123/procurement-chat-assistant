datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plant {
  plant String @id
  name  String
}

model Item {
  item_code      String  @id
  description    String
  uom            String
  category       String
  item_type      String  // Material, Service, Capex
  standard_price Float
}

model Supplier {
  supplier_id    String  @id
  name           String
  city           String
  categories     String  // Semicolon-separated categories
  status         String  // Active, Blocked, Inactive
  on_time_pct    Float
  quality_rating Float
}

model POHistory {
  id                String  @id @default(uuid())
  po_number         String
  po_date           String
  supplier_id       String
  item_code         String
  quantity          Float
  uom               String
  unit_price        Float
  plant             String
  delivered_on_time Boolean
}

model Contract {
  contract_id    String  @id
  supplier_id    String
  supplier_name  String
  start_date     String
  end_date       String
  value_cap      Float
  consumed_value Float   @default(0)
  source         String  @default("register") // register, pdf, manual
}

model ContractLine {
  id          String @id @default(uuid())
  contract_id String
  item_code   String
  description String
  uom         String
  rate        Float

  @@unique([contract_id, item_code])
}

model ContractDocument {
  id          String   @id @default(uuid())
  contract_id String
  file_name   String
  file_path   String
  created_at  DateTime @default(now())
}

model ContractConsumption {
  id          String   @id @default(uuid())
  contract_id String
  po_id       String?
  req_id      String?
  amount      Float
  created_at  DateTime @default(now())
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
  role  String // Requester, Buyer, Procurement Head
}

model PRBatch {
  id           String   @id @default(uuid())
  file_name    String
  status       String   @default("processed")
  total_lines  Int
  created_at   DateTime @default(now())
}

model PRLine {
  id                   String   @id @default(uuid())
  batch_id             String?
  pr_no                String
  pr_line              Int
  created_at           DateTime @default(now())
  requester            String
  department           String
  plant                String
  input_item_code      String?
  resolved_item_code   String
  description          String
  quantity             Float
  uom                  String
  estimated_unit_price Float?
  need_by_date         String
  urgency              String
  match_method         String
  match_confidence     Float
  flags                String   // JSON string array
  status               String   @default("open") // open, grouped, approved
  requirement_id       String?
}

model Requirement {
  id               String   @id // REQ-0001...
  item_code        String
  plant            String
  requirement_date String
  need_by_date     String
  total_quantity   Float
  uom              String
  is_emergency     Boolean  @default(false)
  valuation_price  Float
  valuation_source String
  valuation_ref    String?
  group_value_inr  Float
  decision         String?  // PO or SOURCING_REQUEST
  route            String?  // CONTRACT_PO, SPOT_PO, etc.
  supplier_id      String?
  po_unit_price    Float?
  suggested_suppliers String? // Semicolon separated
  policy_version   String?
  clause           String?
  reason           String?
  po_id            String?
  status           String   @default("pending") // pending, approved, overridden
  approved_by      String?
  approved_at      DateTime?
  rule_trace       String?  // JSON string
  created_at       DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id // PO-0001...
  supplier_id String
  plant       String
  route       String
  total_value Float
  status      String   @default("created")
  created_at  DateTime @default(now())
}

model Override {
  id                  String   @id @default(uuid())
  requirement_id      String
  original_decision   String   // JSON snapshot
  new_route           String
  new_supplier_id     String?
  new_price           Float?
  new_value           Float?
  comment             String
  actor               String
  role                String
  created_at          DateTime @default(now())
}

model PolicyVersion {
  id             String   @id @default(uuid())
  policy_id      String
  version        String   @unique
  effective_from String
  status         String   // draft, pending_approval, approved, active, superseded
  policy_json    String   // Full JSON document
  created_at     DateTime @default(now())
  approved_by    String?
  approved_at    DateTime?
}

model PolicyDocument {
  id         String   @id @default(uuid())
  file_name  String
  file_path  String
  version    String?
  created_at DateTime @default(now())
}

model PolicyChangeSet {
  id             String   @id @default(uuid())
  policy_id      String
  base_version   String
  target_version String
  effective_from String
  is_amendment   Boolean
  operations     String   // JSON string of operations
  citations      String   // JSON string
  assumptions    String   // JSON string
  status         String   @default("pending") // pending, approved, rejected
  created_at     DateTime @default(now())
}

model ChatSession {
  id           String   @id @default(uuid())
  user_name    String
  user_role    String   @default("Requester")
  state_json   String   @default("{}")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model ChatMessage {
  id         String   @id @default(uuid())
  session_id String
  sender     String   // user, assistant
  text       String
  metadata   String?  // JSON string e.g. quickReplies, draft card
  created_at DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  entity_type String
  entity_id   String
  action      String   // create, update, approve, override, etc.
  actor       String
  role        String
  diff_json   String?  // Before/after JSON diff
  created_at  DateTime @default(now())
}
